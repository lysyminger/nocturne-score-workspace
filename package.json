{
  "name": "nocturne-score-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "python -m uvicorn backend.app:app --reload --port 8765",
    "predev:web": "npm run prepare:audio",
    "dev:web": "vite",
    "start": "python -m uvicorn backend.app:app --host 127.0.0.1 --port 8765",
    "prepare:audio": "node scripts/copy-audio-engine.mjs",
    "prebuild": "npm run prepare:audio",
    "build": "tsc -b && vite build",
    "test:api": "python -m pytest backend/tests -q",
    "check": "npm run test:api && npm run build"
  },
  "dependencies": {
    "@coderline/alphatab": "1.8.4",
    "js-synthesizer": "1.13.0",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@coderline/alphaskia": "3.5.147",
    "@coderline/alphaskia-windows": "3.5.147",
    "@coderline/alphatab-vite": "1.8.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "10.0.5",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
